# URL de la API FastAPI (Rodrigo)
VITE_API_URL=http://localhost:8000
# Supabase: SOLO identidad (Auth). Clave pública (anon), nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = usa respuestas de ejemplo de src/services/mocks (sin API ni login)
VITE_USE_MOCKS=true
# Escenario de ejemplo: demo_mode (por defecto) | normal | insufficient_data | format_mockup | historico_corto | sin_extras | sensor_stale | sensor_empty | nasa_down | sensor_test | sensor_suspect | sensor_dry
# Los de sensor y NASA solo tienen efecto con VITE_USE_MOCKS=true; los de recomendación, mientras salga de mocks.
VITE_MOCK_SCENARIO=demo_mode
# De dónde sale POST /api/recommendations: mock (por defecto) | api. Con api hace falta VITE_USE_MOCKS=false y que la ruta exista.
VITE_RECOMMENDATIONS_SOURCE=mock
# Escenario de demostración de Rotaciones: static (por defecto, los dos JSON de Rodrigo en src/data) | api (cuando Rodrigo lo entregue)
VITE_SCENARIO_SOURCE=static
