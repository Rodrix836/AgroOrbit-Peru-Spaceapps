# URL de la API FastAPI (Rodrigo)
VITE_API_URL=http://localhost:8000
# Supabase: SOLO identidad (Auth). Clave pública (anon), nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = usa respuestas de ejemplo de src/services/mocks (sin API ni login)
VITE_USE_MOCKS=true
# Solo con VITE_USE_MOCKS=true: normal | sensor_stale | sensor_empty | nasa_down | insufficient_data | demo_mode | sensor_test | sensor_suspect | sensor_dry
VITE_MOCK_SCENARIO=normal
