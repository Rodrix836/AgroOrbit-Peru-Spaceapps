# Copia este archivo a backend/.env y completa los valores. Nunca subas .env.
APP_NAME=AgroOrbit Perú API
APP_ENV=development
DEBUG=false

# Orígenes permitidos separados por comas (frontend Vite en local incluido).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL: Supabase > Connect > cadena del pooler (psycopg 3).
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require

# Supabase Auth: validación local del JWT de acceso.
# Proyectos con claves asimétricas (ES256/RS256): basta con SUPABASE_URL (se usa su JWKS).
# Proyectos con secreto compartido (HS256): define también SUPABASE_JWT_SECRET.
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_JWT_SECRET=[JWT_SECRET]
SUPABASE_JWT_AUDIENCE=authenticated
