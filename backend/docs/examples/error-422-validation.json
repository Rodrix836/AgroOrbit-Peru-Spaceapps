{
  "request": {
    "method": "POST",
    "path": "/api/devices/readings",
    "headers": {
      "X-Device-Key": "<device_key>",
      "Content-Type": "application/json"
    },
    "body": {
      "readings": [
        {
          "sensor_type": "soil_moisture",
          "raw_value": 5000,
          "calibrated_value": 41.5,
          "unit": "%",
          "recorded_at": "2026-11-14T12:00:00"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "body": {
      "error": {
        "code": "validation_error",
        "message": "La solicitud no es válida.",
        "details": [
          {
            "field": "body.readings.0.recorded_at",
            "message": "Input should have timezone info",
            "type": "timezone_aware"
          }
        ]
      }
    }
  }
}
